generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model Ticket {
  id                String       @id @default(cuid())
  ticketNumber      String       @unique
  verificationToken String       @unique

  firstName         String?
  lastName          String?

  participantName   String
  email             String
  phone             String?

  reservationId     String?      @unique
  eventId           String?

  eventTitle        String
  dateLabel         String
  time              String
  duration          String?

  venue             String
  city              String

  quantity          Int          @default(1)

  status            TicketStatus @default(VALID)

  createdAt         DateTime     @default(now())
  usedAt            DateTime?
  cancelledAt       DateTime?

  @@index([email])
  @@index([phone])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}